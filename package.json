{
	"name": "tiny-file-size",
	"version": "0.4.1",
	"description": "CLI tool for calculating size of files on disk",
	"keywords": [
		"cli",
		"tool",
		"size",
		"compressed",
		"gzip",
		"brotli"
	],
	"repository": "https://github.com/pajecawav/tiny-file-size.git",
	"bugs": "https://github.com/pajecawav/tiny-file-size/issues",
	"homepage": "https://github.com/pajecawav/tiny-file-size#readme",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"bin": {
		"file-size": "dist/cli.js"
	},
	"files": [
		"dist/*.js",
		"dist/*.mjs",
		"dist/*.js.map",
		"dist/*.mjs.map",
		"dist/*.d.ts"
	],
	"license": "MIT",
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "run-p -l lint:*",
		"lint:eslint": "eslint .",
		"lint:tsc": "tsc --noEmit",
		"lint:format": "prettier . --check",
		"format": "prettier . --write",
		"prepare": "husky",
		"prepublishOnly": "pnpm lint && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@vitest/coverage-v8": "^4.0.15",
		"@vitest/ui": "^4.0.15",
		"eslint": "^9.39.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.1.6",
		"typescript-eslint": "^8.48.1",
		"vitest": "^4.0.15"
	},
	"dependencies": {
		"binary-extensions": "^3.1.0",
		"glob": "^13.0.0",
		"picocolors": "^1.0.0"
	},
	"packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
